# Tech AI Assistant by Asad Tech — server env vars.
# Copy this file to .env and fill in REAL values. Never commit .env.
# (No real values are written here on purpose.)

# MongoDB Atlas connection string (Database Access user + Network Access 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Google Gemini API key from Google AI Studio (for the chat)
GEMINI_API_KEY=

# Long random secret for login tokens (make one up, keep it private)
JWT_SECRET=

# Password for the /admin panel (owner only, keep it private)
ADMIN_PASSWORD=

# Port for the backend (default 5000)
PORT=5000

# Free daily token limit per user (see README "Free limits" for the math).
# Owner can change this without touching code. No message-count limit.
FREE_TOKENS_PER_DAY=30000
